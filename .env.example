# Copy to .env and fill in what you need. Everything is optional except where noted for production.

# ── Database ───────────────────────────────────────────────────────────
# Leave empty to use a SQLite file in LAWPILOT_DATA_DIR (fine for trying it out).
# For real use, point this at PostgreSQL (pgvector recommended), e.g.
#   DATABASE_URL=postgresql://lawpilot:secret@localhost:5432/lawpilot
#   DATABASE_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/lawpilot?sslmode=require
DATABASE_URL=
# Only used by docker-compose.yml (the bundled PostgreSQL container).
POSTGRES_PASSWORD=change-me

# ── Server ─────────────────────────────────────────────────────────────
# Where the database and uploaded files live. Use a persistent disk in production.
LAWPILOT_DATA_DIR=./instance
# Public URL, used in invitation and password-reset links.
LAWPILOT_BASE_URL=http://127.0.0.1:5000
# Set to 1 behind HTTPS so session cookies are marked Secure.
LAWPILOT_SECURE_COOKIES=0
# Development mode: shows password-reset links on screen when email is not configured. Never in production.
LAWPILOT_DEV=0
# Emails that become platform administrators on sign-up (the first account always does).
LAWPILOT_ADMIN_EMAILS=
LAWPILOT_ALLOW_REGISTRATION=1
# New accounts per IP address per hour (0 = unlimited). Sign-up emails a temporary password, so SMTP must be set.
LAWPILOT_SIGNUP_RATE_LIMIT=10
LAWPILOT_SESSION_DAYS=14
LAWPILOT_MAX_UPLOAD_MB=25
# Load 66 hand-written landmark case summaries on first run (demo content, labelled as secondary). Off by default.
LAWPILOT_SEED_SUMMARIES=0
# Optional fixed secret; otherwise one is generated and stored in the data directory.
LAWPILOT_SECRET_KEY=

# ── AI answers ─────────────────────────────────────────────────────────
# Every user connects their own key in Settings -> AI models (bring your own key), so usage is billed to them.
# The keys below are the optional SERVER key. Who may fall back to it when they have no key of their own:
#   admins (default: platform admins only) | everyone (all usage billed to this key) | nobody
LAWPILOT_SHARED_KEY_POLICY=admins
# Easiest: leave these empty and set the server key in the app (Corpus admin -> AI settings).
# LLM_PROVIDER: anthropic | gemini | openai | mistral | deepseek | groq | openrouter | none (auto-detected if blank)
LLM_PROVIDER=
# Defaults: anthropic -> claude-opus-5-5
LLM_MODEL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=

# ── Search embeddings ──────────────────────────────────────────────────
# local (built-in, no key) | voyage (voyage-law-2, legal-domain model, recommended) | openai
EMBEDDING_PROVIDER=local
VOYAGE_API_KEY=

# ── Email (invitations, password resets, reminders) ────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── Indian Kanoon official API (paid token from api.indiankanoon.org) ──
KANOON_API_TOKEN=

# ── Error monitoring (optional) ────────────────────────────────────────
# Create a free project at sentry.io (platform: Flask) and paste its DSN. Events are scrubbed of
# request bodies, query strings, cookies, emails, IPs and local variables before they leave the server.
SENTRY_DSN=
# Defaults to VERCEL_ENV (production / preview) or "development".
SENTRY_ENVIRONMENT=
# Share of requests traced for performance (0 = off, 0.1 = 10%).
SENTRY_TRACES_SAMPLE_RATE=0
